model RecommendationEvent {
  id         String   @id
  userId     String
  sessionId  String
  type       String
  trackId    String?
  playlistId String?
  value      String?
  context    Json
  createdAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RegionSoundTrend {
  id          String   @id @default(cuid())
  regionCode  String
  regionName  String
  period      String
  topMoodTags String[]
  topTrackIds String[]
  sampleSize  Int?

  @@unique([regionCode, period])
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String
  scope     String
  userId    String
  response  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scope, key, userId])
}

model DbTestRecord {
  id        String   @id @default(cuid())
  label     String
  payload   Json?
  createdAt DateTime @default(now())
}
